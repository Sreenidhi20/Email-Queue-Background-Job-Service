# Database: SQLite works for the unit tests; use Postgres to run the full system.
DATABASE_URL=sqlite:///./mailroom.db
REDIS_URL=redis://localhost:6379/0

# Auth: name:key pairs, keys 16+ characters. Replace the dev key before deploying.
API_KEYS=dev:dev-key-change-me-0123456789
REQUIRE_API_KEY=true
RATE_LIMIT_PER_MINUTE=60

# Mail: smtp (Mailpit locally) or resend (HTTPS API, for hosts that block SMTP)
MAIL_BACKEND=smtp
MAIL_FROM=noreply@mailroom.local
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# Retries and scheduling
RETRY_BASE_SECONDS=10
RETRY_MAX_SECONDS=600
MAX_SEND_AHEAD_DAYS=7

# Cron jobs (UTC)
SENT_RETENTION_DAYS=30
DIGEST_TO_EMAIL=you@example.com
CLEANUP_HOUR_UTC=21
CLEANUP_MINUTE_UTC=30
DIGEST_HOUR_UTC=2
DIGEST_MINUTE_UTC=30

# Flower (will not start without a user and an 8+ character password)
FLOWER_USER=admin
FLOWER_PASSWORD=
FLOWER_PORT=5555
