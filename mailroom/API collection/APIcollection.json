{
  "info": {
    "_postman_id": "4f56cd3e-5c2a-4a8a-9653-d3df86a372da",
    "name": "Mailroom API",
    "description": "Requests for checking health, queueing emails, and reviewing or replaying dead letters. An API key is required except for the health check.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "jobId",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "mailroom-demo-1",
      "type": "string"
    },
    {
      "key": "status",
      "value": "sent",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "dev-key-change-me-0123456789",
      "type": "string"
    },
    {
      "key": "deadLetterId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Checks database and Redis health.",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "Queue email",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 202) {",
              "    const response = pm.response.json();",
              "    if (response.data && response.data.id) {",
              "        pm.collectionVariables.set('jobId', response.data.id);",
              "        console.log('Saved job ID:', response.data.id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text",
            "description": "Reuse this key to return the existing job without enqueueing another email. Change it to create a new job."
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"toEmail\": \"test@example.com\",\n  \"subject\": \"Mailroom Postman test\",\n  \"body\": \"Hello from the Mailroom Postman collection.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/emails",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "emails"
          ]
        },
        "description": "Queues an email and stores the returned data.id in the collection variable jobId. Returns HTTP 202."
      },
      "response": []
    },
    {
      "name": "Get email job",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/emails/{{jobId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "emails",
            "{{jobId}}"
          ]
        },
        "description": "Returns the saved job's current status. Run Queue email first."
      },
      "response": []
    },
    {
      "name": "List email jobs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/emails?page=1&pageSize=20&status={{status}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "emails"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            },
            {
              "key": "status",
              "value": "{{status}}",
              "description": "Optional: queued, sending, sent, retrying, or dead. Remove this query parameter to list all jobs."
            }
          ]
        },
        "description": "Lists up to 20 jobs filtered by the collection variable status."
      },
      "response": []
    },
    {
      "name": "Queue scheduled email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/emails",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "emails"
          ]
        },
        "description": "Send later. Include a timezone offset or Z; without one the time is treated as UTC. At most MAX_SEND_AHEAD_DAYS ahead.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"toEmail\": \"test@example.com\",\n  \"subject\": \"Scheduled from Postman\",\n  \"body\": \"This was scheduled.\",\n  \"sendAt\": \"2026-12-01T09:00:00+05:30\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 202) { pm.collectionVariables.set('jobId', pm.response.json().data.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "List dead letters",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/dead-letters?replayed=false&page=1&pageSize=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "dead-letters"
          ],
          "query": [
            {
              "key": "replayed",
              "value": "false"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        },
        "description": "Emails that ran out of attempts. Saves the first id into deadLetterId."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "if (r.data && r.data.items && r.data.items.length) { pm.collectionVariables.set('deadLetterId', r.data.items[0].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Replay dead letter",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/dead-letters/{{deadLetterId}}/replay",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "dead-letters",
            "{{deadLetterId}}",
            "replay"
          ]
        },
        "description": "Re-queues the dead email from attempt 0. Returns 202; a second call returns 409."
      },
      "response": []
    }
  ]
}
